{
  "expo": {
    "name": "SmartRoadRouter",
    "slug": "smart-road-router",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "smartroadrouter",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SmartRoadRouter to use your location to plan a trip."
        }
      ]
    ],
    "android": {
      "package": "com.smartroadrouter.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
